{
  "name": "home-widget-platform",
  "private": true,
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --workspace-concurrency=1 --filter !@home-widget-platform/integration --filter !@home-widget-platform/resilience test",
    "test:integration": "pnpm --filter @home-widget-platform/integration test",
    "test:resilience": "pnpm --filter @home-widget-platform/resilience test",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:resilience",
    "run:resilience:product": "pnpm --filter @home-widget-platform/resilience run test -- product-down.test.ts",
    "run:resilience:redis": "pnpm --filter @home-widget-platform/resilience run test -- redis-down.test.ts",
    "run:resilience:ingester": "pnpm --filter @home-widget-platform/resilience run test -- ingester-restart.test.ts",
    "run:latency": "npx tsx tests/integration/latency_verification.ts",
    "run:throughput": "npx tsx tests/resilience/throughput_isolation.ts",
    "run:convergence": "npx tsx tests/integration/convergence_verification.ts",
    "up": "docker compose up -d",
    "down": "docker compose down"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.16.0",
    "axios": "^1.13.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "pg": "^8.16.3",
    "prettier": "^3.7.4",
    "redis": "^5.10.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "engines": {
    "node": ">=20"
  }
}