{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://home-widget-platform/schemas/widget.json",
    "type": "object",
    "required": [
        "schema_version",
        "data_version",
        "root"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "type": "integer"
        },
        "data_version": {
            "type": "integer"
        },
        "min_ios_version": {
            "type": "integer"
        },
        "root": {
            "$ref": "#/definitions/widget_container"
        }
    },
    "definitions": {
        "padding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "top": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 24
                },
                "right": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 24
                },
                "bottom": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 24
                },
                "left": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 24
                }
            }
        },
        "component": {
            "oneOf": [
                {
                    "$ref": "#/definitions/widget_container"
                },
                {
                    "$ref": "#/definitions/text_row"
                },
                {
                    "$ref": "#/definitions/action_button"
                },
                {
                    "$ref": "#/definitions/section_header"
                },
                {
                    "$ref": "#/definitions/deal_card"
                },
                {
                    "$ref": "#/definitions/horizontal_carousel"
                },
                {
                    "$ref": "#/definitions/grid"
                },
                {
                    "$ref": "#/definitions/list"
                },
                {
                    "$ref": "#/definitions/tariff_tile"
                }
            ]
        },
        "widget_container": {
            "type": "object",
            "required": [
                "type",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "widget_container"
                },
                "title": {
                    "type": "string",
                    "maxLength": 120
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                },
                "items": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                        "$ref": "#/definitions/component"
                    }
                }
            }
        },
        "text_row": {
            "type": "object",
            "required": [
                "type",
                "text"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "text_row"
                },
                "text": {
                    "type": "string",
                    "maxLength": 120
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                }
            }
        },
        "action_button": {
            "type": "object",
            "required": [
                "type",
                "label",
                "deeplink"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "action_button"
                },
                "label": {
                    "type": "string",
                    "maxLength": 120
                },
                "deeplink": {
                    "type": "string"
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                }
            }
        },
        "section_header": {
            "type": "object",
            "required": [
                "type",
                "title"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "section_header"
                },
                "title": {
                    "type": "string",
                    "maxLength": 120
                },
                "subtitle": {
                    "type": "string",
                    "maxLength": 120
                },
                "icon": {
                    "type": "string",
                    "maxLength": 50
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                }
            }
        },
        "deal_card": {
            "type": "object",
            "required": [
                "type",
                "title",
                "image_url",
                "deeplink"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "deal_card"
                },
                "title": {
                    "type": "string",
                    "maxLength": 120
                },
                "category": {
                    "type": "string",
                    "maxLength": 120
                },
                "image_url": {
                    "type": "string",
                    "format": "uri"
                },
                "price": {
                    "type": "number",
                    "minimum": 0
                },
                "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                },
                "original_price": {
                    "type": "number",
                    "minimum": 0
                },
                "badge_text": {
                    "type": "string",
                    "maxLength": 120
                },
                "deeplink": {
                    "type": "string"
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                }
            }
        },
        "horizontal_carousel": {
            "type": "object",
            "required": [
                "type",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "horizontal_carousel"
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                },
                "items": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                        "$ref": "#/definitions/deal_card"
                    }
                }
            }
        },
        "grid": {
            "type": "object",
            "required": [
                "type",
                "columns",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "grid"
                },
                "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                },
                "items": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                        "$ref": "#/definitions/deal_card"
                    }
                }
            }
        },
        "list": {
            "type": "object",
            "required": [
                "type",
                "items"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "list"
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                },
                "items": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                        "$ref": "#/definitions/component"
                    }
                }
            }
        },
        "tariff_tile": {
            "type": "object",
            "required": [
                "type",
                "data_gb",
                "price_per_month",
                "compare_count",
                "deeplink"
            ],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "const": "tariff_tile"
                },
                "data_gb": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                },
                "price_per_month": {
                    "type": "number",
                    "minimum": 0
                },
                "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                },
                "compare_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "deeplink": {
                    "type": "string"
                },
                "badge_text": {
                    "type": "string",
                    "maxLength": 120
                },
                "padding": {
                    "$ref": "#/definitions/padding"
                }
            }
        }
    }
}